# ── Dependencies ──────────────────────────────────────
node_modules/
.pnp.*
.yarn/

# ── Build output ──────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Environment ───────────────────────────────────────
.env
.env.*
!.env.example

# ── IDE ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Coverage ──────────────────────────────────────────
coverage/
.nyc_output/

# ── OS ────────────────────────────────────────────────
.DS_Store
Desktop.ini
