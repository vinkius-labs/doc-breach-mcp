    "url": "https://github.com/vinkius-labs/doc-breach-mcp/issues"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@vurb/core": "^3.19.3",
